{
  "vantage": "us-east",
  "timeout_ms": 8000,
  "monitor": true,
  "discord_webhook": "${DISCORD_WEBHOOK}",
  "checkpoint_every_sec": 300,
  "monitor_debounce_n": 2,
  "//adaptive_alert": "Alert-only adaptive Discord threshold for operational<->degraded (KAN-247). false/absent = today's behaviour. Never changes events, ledger, website or SLA (still slo.degraded_avg_ms). Tuning is optional; values shown are the defaults.",
  "adaptive_alert": false,
  "adaptive_alert_tuning": {
    "window_min": 180, "min_issues": 5, "top_n": 5,
    "raise_factor": 1.1, "lower_ratio": 0.5, "recheck_min": 180,
    "timezone": "Asia/Jerusalem", "daily_slots": ["10:00", "16:00"], "daily_gap_min": 180
  },
  "ledger_signing_key": "${LEDGER_SIGNING_KEY}",
  "clickhouse": {
    "url": "http://127.0.0.1:18123",
    "db": "sla",
    "user": "flashproxy-status-worker",
    "password": "${SLA_WORKER_PASSWORD}"
  },

  "origin": "${ORIGIN_HOST}:8080",
  "origin_ipv6": "[${ORIGIN_IPV6}]:8080",
  "scrape_hosts": [
    "www.google.com:443", "www.cloudflare.com:443", "www.facebook.com:443",
    "www.wikipedia.org:443", "www.microsoft.com:443"
  ],
  "scenarios": {
    "net_rtt_interval_ms": 15000, "net_rtt_count": 3,
    "streaming_interval_ms": 120000, "streaming_bytes": 5242880,
    "large_object_interval_ms": 60000, "large_object_bytes": 262144,
    "hifreq_interval_ms": 60000, "hifreq_count": 10,
    "scraping_interval_ms": 60000,
    "long_session_interval_ms": 180000, "long_session_hold_ms": 20000
  },

  "slo": {
    "degraded_avg_ms": 50,
    "degraded_for_min": 5,
    "down_success_pct": 90,
    "stale_seconds": 120
  },

  "//connect_targets": "The connect scenario probes a stratified sample of this pool each cycle: the origin (group 'origin', ALWAYS probed = availability floor) plus one endpoint from each of GroupsPerCycle other provider groups. Best result wins (lowest ttfb); Down only if every sampled endpoint fails. All are HTTP/80 connectivity checks with a fetchable body or 204 — never :443 CONNECT-only (that zeros ttfb). The pool below is shared; give v6 packages the v6 origin. The legacy singular connect_target/origin_get is still honored as a one-element fallback.",
  "//connect_pool_shared": [
    { "target": "detectportal.firefox.com:80",      "path": "/success.txt",              "group": "mozilla" },
    { "target": "connectivitycheck.gstatic.com:80", "path": "/generate_204",             "group": "google" },
    { "target": "clients3.google.com:80",           "path": "/generate_204",             "group": "google" },
    { "target": "www.msftconnecttest.com:80",       "path": "/connecttest.txt",          "group": "microsoft" },
    { "target": "www.msftncsi.com:80",              "path": "/ncsi.txt",                 "group": "microsoft" },
    { "target": "captive.apple.com:80",             "path": "/hotspot-detect.html",      "group": "apple" },
    { "target": "cp.cloudflare.com:80",             "path": "/generate_204",             "group": "cloudflare" },
    { "target": "connectivity-check.ubuntu.com:80", "path": "/",                         "group": "ubuntu" },
    { "target": "network-test.debian.org:80",       "path": "/nm",                       "group": "debian" },
    { "target": "nmcheck.gnome.org:80",             "path": "/check_network_status.txt", "group": "gnome" }
  ],
  "targets": [
    {
      "package": "isp", "proxy_url": "${ISP_PROXY_URL}", "ip_version": 4, "interval_ms": 20000,
      "connect_targets": [
        { "target": "${ORIGIN_HOST}:8080",              "path": "/connect",                  "group": "origin" },
        { "target": "detectportal.firefox.com:80",      "path": "/success.txt",              "group": "mozilla" },
        { "target": "connectivitycheck.gstatic.com:80", "path": "/generate_204",             "group": "google" },
        { "target": "clients3.google.com:80",           "path": "/generate_204",             "group": "google" },
        { "target": "www.msftconnecttest.com:80",       "path": "/connecttest.txt",          "group": "microsoft" },
        { "target": "www.msftncsi.com:80",              "path": "/ncsi.txt",                 "group": "microsoft" },
        { "target": "captive.apple.com:80",             "path": "/hotspot-detect.html",      "group": "apple" },
        { "target": "cp.cloudflare.com:80",             "path": "/generate_204",             "group": "cloudflare" },
        { "target": "connectivity-check.ubuntu.com:80", "path": "/",                         "group": "ubuntu" },
        { "target": "network-test.debian.org:80",       "path": "/nm",                       "group": "debian" },
        { "target": "nmcheck.gnome.org:80",             "path": "/check_network_status.txt", "group": "gnome" }
      ]
    },
    { "package": "datacenter",       "proxy_url": "${DC_PROXY_URL}",      "ip_version": 4, "interval_ms": 20000, "connect_target": "${ORIGIN_HOST}:8080",   "origin_get": "/connect" },
    { "package": "ipv6-residential", "proxy_url": "${IPV6_PROXY_URL}",    "ip_version": 6, "interval_ms": 20000, "connect_target": "[${ORIGIN_IPV6}]:8080", "origin_get": "/connect" },
    { "package": "ipv6-datacenter",  "proxy_url": "${IPV6_DC_PROXY_URL}", "ip_version": 6, "interval_ms": 20000, "connect_target": "[${ORIGIN_IPV6}]:8080", "origin_get": "/connect" },
    { "package": "isp_eu",           "proxy_url": "${ISP_EU_PROXY_URL}",  "ip_version": 4, "interval_ms": 20000, "connect_target": "${ORIGIN_HOST}:8080",   "origin_get": "/connect" }
  ]
}
